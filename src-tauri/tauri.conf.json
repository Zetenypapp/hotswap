{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HotSwap",
  "version": "0.4.0",
  "identifier": "app.hotswap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HotSwap",
        "width": 1440,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#111316",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com",
        "frame-src": "https: http:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "HotSwap",
    "shortDescription": "Swap the way you play, in real time.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMEQ4MDFDRjMxODY3N0QKUldSOVp4anpISUFOSGJuSWZVa2crTG0xTDFLWnpDdTJBNjhtUWJRNlBBWnc2QUVJQjJhaFEyQXQK",
      "endpoints": [
        "https://github.com/Zetenypapp/hotswap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}