{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotswap",
  "version": "0.1.0",
  "identifier": "app.hotswap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotswap",
        "width": 1440,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#111316"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hotswap",
    "shortDescription": "Swap the way you play, in real time.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
