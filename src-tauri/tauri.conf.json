{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotswap",
  "version": "0.2.4",
  "identifier": "app.hotswap.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotswap",
        "width": 1440,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#111316",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hotswap",
    "shortDescription": "Swap the way you play, in real time.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMEQ4MDFDRjMxODY3N0QKUldSOVp4anpISUFOSGJuSWZVa2crTG0xTDFLWnpDdTJBNjhtUWJRNlBBWnc2QUVJQjJhaFEyQXQK",
      "endpoints": [
        "https://github.com/Zetenypapp/hotswap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}