{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "In-game overlay window: only the commands it uses",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:event:default",
    "allow-log-ui",
    "allow-overlay-fit",
    "allow-overlay-input",
    "allow-overlay-ready",
    "allow-system-stats-full",
    "allow-voice-send",
    "allow-voice-start",
    "allow-voice-stop",
    "allow-voice-state"
  ]
}
